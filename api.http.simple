##api

##1.Admin

###1.1 Login
POST http://localhost:9092/admin/login
content-type: application/json

{
  "email": "{{$dotenv ADMIN_EMAIL}}",
  "password": "{{$dotenv ADMIN_PASSWORD}}",
  "rememberMe": "{{$dotenv ADMIN_REMEMBER_ME}}"
}
###

###1.2 Signup
GET http://localhost:9092/admin/auth/register-admin
content-type: application/json

{
  "firstName": "{{$dotenv ADMIN_FIRST_NAME}}",
  "lastName": "{{$dotenv ADMIN_LAST_NAME}}",
  "email": "{{$dotenv ADMIN_SIGNUP_EMAIL}}",
  "password": "{{$dotenv ADMIN_SIGNUP_PASSWORD}}",
  "confirmPassword": "{{$dotenv ADMIN_SIGNUP_PASSWORD}}"
}
###

###1.3 Forgot Password
POST http://localhost:9092/admin/forgot-password
content-type: application/json

{
  "email": "{{$dotenv ADMIN_EMAIL}}"
}
###

###1.3.1 Reset Password
POST http://localhost:9092/admin/reset-password
content-type: application/json

{
  "resetPasswordToken": "{{$dotenv ADMIN_RESET_PASSWORD_TOKEN}}",
  "password": "{{$dotenv ADMIN_RESET_PASSWORD}}"
}
###

###1.4 Profile
GET http://localhost:9092/admin/me
Authorization: Bearer <paste-admin-token>
###

##2.User

###2.1 Login
POST http://localhost:9092/api/auth/local
content-type: application/json

{
  "identifier": "{{$dotenv USER_EMAIL}}",
  "password": "{{$dotenv USER_PASSWORD}}"
}
###

###2.2 Register
POST http://localhost:9092/api/auth/local/register
content-type: application/json

{
  "username": "{{$dotenv USER_USERNAME}}",
  "email": "{{$dotenv USER_EMAIL}}",
  "password": "{{$dotenv USER_SIGNUP_PASSWORD}}",
  "confirmPassword": "{{$dotenv USER_SIGNUP_PASSWORD}}"
}
###

###2.3 Forgot Password
POST http://localhost:9092/api/auth/forgot-password
content-type: application/json

{
  "email": "{{$dotenv USER_FORGOT_EMAIL}}"
}
###

###2.3.1 Reset Password
POST http://localhost:9092/api/auth/reset-password
content-type: application/json

{
  "resetPasswordToken": "{{$dotenv USER_RESET_PASSWORD_TOKEN}}",
  "password": "{{$dotenv USER_RESET_PASSWORD}}",
  "passwordConfirmation": "{{$dotenv USER_RESET_PASSWORD}}"
}
###

###2.4 Profile
GET http://localhost:9092/api/users/me
Authorization: Bearer {{$dotenv USER_BEARER_TOKEN}}
###

##3.Content

###3.1 Student

###3.1.1 Create
POST http://localhost:9092/api/students
content-type: application/json
Authorization: Bearer {{$dotenv USER_BEARER_TOKEN}}

{
  "data": {
    "name": "{{$dotenv STUDENT_CREATE_NAME}}",
    "mobile": "{{$dotenv STUDENT_CREATE_MOBILE}}",
    "cardId": "{{$dotenv STUDENT_CREATE_CARD_ID}}"
  }
}
###

###3.1.2 List All
GET http://localhost:9092/api/students
Authorization: Bearer {{$dotenv USER_BEARER_TOKEN}}
###

###3.1.3 List with ID
GET http://localhost:9092/api/students/<student-id>
Authorization: Bearer {{$dotenv USER_BEARER_TOKEN}}
###

###3.1.4 Update
PUT http://localhost:9092/api/students/<student-id>
content-type: application/json
Authorization: Bearer {{$dotenv USER_BEARER_TOKEN}}

{
  "data": {
    "name": "{{$dotenv STUDENT_UPDATE_NAME}}",
    "mobile": "{{$dotenv STUDENT_UPDATE_MOBILE}}",
    "cardId": "{{$dotenv STUDENT_UPDATE_CARD_ID}}"
  }
}
###

###3.1.5 Delete
DELETE http://localhost:9092/api/students/<student-id>
Authorization: Bearer {{$dotenv USER_BEARER_TOKEN}}
###

###3.2 Subject

###3.2.1 Create
POST http://localhost:9092/api/subjects
content-type: application/json
Authorization: Bearer {{$dotenv USER_BEARER_TOKEN}}

{
  "data": {
    "name": "{{$dotenv SUBJECT_CREATE_NAME}}"
  }
}
###

###3.2.2 List All
GET http://localhost:9092/api/subjects
Authorization: Bearer {{$dotenv USER_BEARER_TOKEN}}
###

###3.2.3 List with ID
GET http://localhost:9092/api/subjects/<subject-id>
Authorization: Bearer {{$dotenv USER_BEARER_TOKEN}}
###

###3.2.4 Update
PUT http://localhost:9092/api/subjects/<subject-id>
content-type: application/json
Authorization: Bearer {{$dotenv USER_BEARER_TOKEN}}

{
  "data": {
    "name": "{{$dotenv SUBJECT_UPDATE_NAME}}"
  }
}
###

###3.2.5 Delete
DELETE http://localhost:9092/api/subjects/<subject-id>
Authorization: Bearer {{$dotenv USER_BEARER_TOKEN}}
###

